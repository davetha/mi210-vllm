# cp .env.example .env and edit.
#
# This file drives compose.yaml, which is for a deployment you run repeatedly.
# To serve a model once, use ./run.sh instead -- see docs/RUNNING.md.

# Selects tuning/by-deployment/<this>/. Use `generic` for anything untuned:
# the folder is empty and vLLM falls back to its own shipped configs.
DEPLOYMENT=generic

# An HF repo id, or a path INSIDE the container. Paths outside the HF cache
# also need a volume mount -- see the commented mount in compose.yaml.
MODEL=/root/.cache/huggingface/hub/models--.../snapshots/<sha>

TP_SIZE=2

# Omit or match the model. vLLM derives this from the checkpoint when unset;
# setting it ABOVE what the model supports is a hard startup failure, so the
# 262144 default only suits long-context models. >131072 is what the
# paged-attention work in this image is for.
MAX_MODEL_LEN=262144

PORT=8000
HF_CACHE=~/.cache/huggingface
